             <property name="styleSheet">
              <string notr="true">QPushButton {
    background-color: none; /* Default color */
    border: none;
    color: black;
    border-left: 1px solid gray;
    border-right: 1px solid gray;
    border-top: 1px solid gray;
    border-bottom: 1px solid gray;
}

QPushButton:hover {
    background-color: rgba(0, 0, 0, 0.1); /* Light darkening on hover */
}

QPushButton:checked {
    background-color: rgb(255, 140, 0); /* Orange color when clicked */
    border-left: 1px solid rgb(204, 113, 0);
    border-right: 1px solid rgb(204, 113, 0);
    border-bottom: 1px solid rgb(204, 113, 0);
    border-top: 1px solid rgb(204, 113, 0);
    color: white;
}

QPushButton:checked:hover {
    background-color: rgb(255, 165, 0); /* Lighter orange when hovered in active state */
}
</string>
