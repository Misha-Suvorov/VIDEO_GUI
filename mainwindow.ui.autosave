    background-color: rgb(255, 140, 0); /* Orange color when clicked */
    border-left: 1px solid rgb(204, 113, 0);
    border-right: 1px solid rgb(204, 113, 0);
    border-bottom: 1px solid rgb(204, 113, 0);
