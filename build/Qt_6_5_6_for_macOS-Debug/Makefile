	$(DEL_FILE) -r $(INSTALL_ROOT)/opt/GUI_UDP/bin/GUI_UDP.app
	
	$(QINSTALL) GUI_UDP.app $(INSTALL_ROOT)/opt/GUI_UDP/bin/GUI_UDP.app

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/GUI_UDP/bin/GUI_UDP.app
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/GUI_UDP/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

.SUFFIXES:

