GUI_UDP.app/Contents/PkgInfo: 
	@test -d GUI_UDP.app/Contents || mkdir -p GUI_UDP.app/Contents
	@$(DEL_FILE) GUI_UDP.app/Contents/PkgInfo
	@echo "APPL????" > GUI_UDP.app/Contents/PkgInfo
GUI_UDP.app/Contents/Info.plist: 
	@test -d GUI_UDP.app/Contents || mkdir -p GUI_UDP.app/Contents
	@$(DEL_FILE) GUI_UDP.app/Contents/Info.plist
	@plutil -convert xml1 -o - ../../../Qt/6.5.6/macos/mkspecs/macx-clang/Info.plist.app | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,mykhailo.GUI-UDP,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},mykhailo.GUI-UDP,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},11.0,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,GUI_UDP,g" -e "s,@LIBRARY@,GUI_UDP,g" -e "s,\$${EXECUTABLE_NAME},GUI_UDP,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >GUI_UDP.app/Contents/Info.plist

